# Production / staging settings for docker-compose.prod.yml.
# On the server: cp .env.production.example .env.production && chmod 600 .env.production
# Never commit .env.production. Keep a copy in a password manager.
# Generate a secret straight into this file (never paste it into chat):
#   sed -i "s|^DJANGO_SECRET_KEY=.*|DJANGO_SECRET_KEY=$(openssl rand -base64 48 | tr -d '\n/+=')|" .env.production
# Values containing spaces or < > must be in double quotes.
# Step-by-step guide: .claude/skills/deploy-ledger/SKILL.md

# --- Site --------------------------------------------------------------------
# staging (robots.txt blocks search engines; fake agents allowed) or production
DJANGO_ENV=production
# Bare domain; Caddy also redirects www.<domain> here (create both DNS records)
SITE_DOMAIN=example.in
# Let's Encrypt certificate notices
ACME_EMAIL=you@example.in
SITE_BASE_URL=https://example.in
WAGTAILADMIN_BASE_URL=https://example.in
DJANGO_ALLOWED_HOSTS=example.in,www.example.in
DJANGO_SECRET_KEY=change-me-to-50-plus-random-characters
# The git tag you deployed (image tag, Sentry release)
APP_VERSION=v1.0.0

# --- Database ----------------------------------------------------------------
# Bundled PostgreSQL on this server (the Hostinger setup). COMPOSE_PROFILES
# makes every docker compose command start it; backups: docker/backup.sh.
COMPOSE_PROFILES=bundled-db
POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgres://ledger:change-me-long-random@db:5432/ledger
# Managed PostgreSQL instead: remove the three lines above and set
# DATABASE_URL=postgres://ledger:password@your-db-host:25060/ledger?sslmode=require

# --- AI agents ---------------------------------------------------------------
# Production refuses NEWSDESK_WRITER=fake. Without a key, agent runs fail with
# a clear error and nothing is written (hand-written articles work as normal).
NEWSDESK_WRITER=anthropic
ANTHROPIC_API_KEY=

# --- Email: Brevo SMTP (complaint acknowledgements, staff notifications) -----
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
# Brevo → SMTP & API → SMTP: the login (…@smtp-brevo.com) and an SMTP key
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="The Ledger <newsroom@example.in>"
DJANGO_ADMINS=you@example.in

# --- Backups: Cloudflare R2 + healthchecks.io (docker/backup.sh) -------------
BACKUP_R2_BUCKET=ledger-backups
# https://<account id>.r2.cloudflarestorage.com
BACKUP_R2_ENDPOINT=
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# healthchecks.io ping URL: alerts you if a night's backup doesn't arrive
BACKUP_PING_URL=

# --- Monitoring --------------------------------------------------------------
SENTRY_DSN=

# --- Media on object storage (optional; empty = images on this server's disk,
# included in the nightly backup)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_ACL=
MEDIA_CDN_DOMAIN=

# --- Tuning (optional) -------------------------------------------------------
# WEB_CONCURRENCY=3
# WORKER_CONCURRENCY=2
# DJANGO_HSTS_SECONDS=31536000
