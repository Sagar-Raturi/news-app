# Production / staging settings for docker-compose.prod.yml.
# On the server: cp .env.production.example .env.production && chmod 600 .env.production
# Never commit .env.production. Keep a copy in a password manager.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Site --------------------------------------------------------------------
# or staging (robots.txt then blocks search engines)
DJANGO_ENV=production
# bare domain; Caddy also redirects www.example.in here
SITE_DOMAIN=example.in
# Let's Encrypt expiry notices
ACME_EMAIL=you@example.in
SITE_BASE_URL=https://example.in
WAGTAILADMIN_BASE_URL=https://example.in
DJANGO_ALLOWED_HOSTS=example.in,www.example.in
DJANGO_SECRET_KEY=change-me-to-50-plus-random-characters
# the git tag you deployed (shown in Sentry)
APP_VERSION=v1.0.0

# --- Database ----------------------------------------------------------------
# Managed PostgreSQL (recommended):
DATABASE_URL=postgres://ledger:password@your-db-host:25060/ledger?sslmode=require
# Or the bundled database (`--profile bundled-db`); set both:
# POSTGRES_PASSWORD=long-random-password
# DATABASE_URL=postgres://ledger:long-random-password@db:5432/ledger

# --- AI agents ---------------------------------------------------------------
# Production refuses NEWSDESK_WRITER=fake. Without a key, agent runs fail with
# a clear error and nothing is written.
NEWSDESK_WRITER=anthropic
ANTHROPIC_API_KEY=

# --- Email (Amazon SES, Postmark…) -------------------------------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="The Ledger <newsroom@example.in>"
DJANGO_ADMINS=you@example.in

# --- Media on object storage (optional; leave the bucket empty to keep images on the server's disk)
AWS_STORAGE_BUCKET_NAME=
# Endpoint, e.g. https://blr1.digitaloceanspaces.com (blank for AWS)
AWS_S3_ENDPOINT_URL=
# Region, e.g. blr1 or ap-south-1
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# DigitalOcean Spaces; blank on AWS (use a bucket policy)
AWS_DEFAULT_ACL=public-read
# e.g. media.example.in (CDN in front of the bucket)
MEDIA_CDN_DOMAIN=

# --- Monitoring --------------------------------------------------------------
SENTRY_DSN=

# --- Tuning (optional) -------------------------------------------------------
# WEB_CONCURRENCY=3
# WORKER_CONCURRENCY=2
# DJANGO_HSTS_SECONDS=31536000
