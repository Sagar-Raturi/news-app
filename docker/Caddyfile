# Caddy: HTTPS (automatic Let's Encrypt certificates), www → apex redirect,
# compression, uploaded media from disk, everything else to Django.
# SITE_DOMAIN and ACME_EMAIL come from .env.production.

{
	email {$ACME_EMAIL}
	servers {
		# Cloudflare's edge addresses (https://www.cloudflare.com/ips/). When a
		# request comes through Cloudflare, the reader's address is taken from
		# CF-Connecting-IP; anyone else can't fake it.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Uploaded images when they are kept on disk (no object storage bucket).
	handle /media/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy web:8000 {
			# The reader's real address, for login rate limiting.
			header_up X-Real-IP {client_ip}
			header_down -Server
		}
	}

	log {
		output stdout
		format console
	}
}
