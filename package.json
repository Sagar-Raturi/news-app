{
  "name": "the-ledger",
  "private": true,
  "description": "Front-end build for The Ledger (Tailwind CSS + vendored HTMX)",
  "scripts": {
    "build:css": "tailwindcss -i static/src/main.css -o static/css/site.css --minify",
    "watch:css": "tailwindcss -i static/src/main.css -o static/css/site.css --watch=always",
    "vendor:htmx": "cp node_modules/htmx.org/dist/htmx.min.js static/js/htmx.min.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "htmx.org": "^2.0.11",
    "tailwindcss": "^4.3.3"
  }
}
