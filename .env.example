# Copy to .env (same folder as docker-compose.yml) and fill in.
# .env is git-ignored: never commit your key.

# Anthropic API key for the AI desk agents (https://platform.claude.com/)
ANTHROPIC_API_KEY=

# "anthropic" (real drafts) or "fake" (canned drafts, no API calls, no cost)
NEWSDESK_WRITER=anthropic
